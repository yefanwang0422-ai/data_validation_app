# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/
.dist/
build/
dist/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
ENV/
env/

